# 실제 값은 .env 에 넣는다. .env 는 절대 커밋하지 않는다 (.gitignore 확인).
# 거래소 · 증권사 키로 주문 · 잔고 · 계좌를 다루는 코드는 없다 (걷어 냈다, README 6-3).

# 국내 주식 원천 (주 원천, docs/KIS.md · ADR 0012) — 한국투자증권 Open API, 시세 조회만.
# 접속 창구(src/mdp/kis/client.py)가 허용한 시세 조회만 보낸다. 계좌 번호는 넣지 않는다.
MDP_KIS_ENV=demo                  # demo(모의투자, 기본) | real(실전 키를 조회 전용으로)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_APP_KEY=
KIS_APP_SECRET=

AT_MODE=backtest                  # backtest | paper | testnet | live

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 11 이후
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FRED_API_KEY=
